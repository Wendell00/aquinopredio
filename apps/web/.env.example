# Endereço interno da API, usado pelo proxy /api do Next e pelas páginas renderizadas no servidor.
# Não vai para o navegador.
API_INTERNAL_URL=http://localhost:3001
# Origem pública das imagens (S3/CDN) — pública por natureza, entra na CSP e no next/image
NEXT_PUBLIC_STORAGE_URL=http://localhost:8333

# Chat em tempo real (Supabase Realtime). Públicas por natureza: URL do projeto e a
# "Publishable key" (sb_publishable_…). Vazias = chat só com polling. A URL entra na CSP (connect-src).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
