# Copie para .env e ajuste. Tudo que não estiver aqui tem padrão em src/config/env.ts.

# App
NODE_ENV=development
PORT=3001
# URL pública do front; o navegador acessa a API pelo proxy /api do Next (mesma origem)
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# IPs dos proxies confiáveis (Next em dev, load balancer em produção)
TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Banco (PostgreSQL + PostGIS) — pnpm db:up na raiz. Mesma conexão usada no Beekeeper Studio
DATABASE_URL=postgresql://aquinopredio:aquinopredio@localhost:5433/aquinopredio
# Filas (BullMQ)
REDIS_URL=redis://localhost:6380

# Autenticação (Better Auth). Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Login com Google (opcional). Redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bloqueia senhas vazadas (consulta Have I Been Pwned por k-anonimato). Recomendado em produção.
AUTH_CHECK_PWNED_PASSWORDS=false

# E-mail — em dev o Mailpit captura tudo: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Aqui no Prédio <nao-responda@aquinopredio.local>

# Imagens (S3 compatível). Em dev: SeaweedFS do docker compose
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=aquinopredio
STORAGE_ACCESS_KEY_ID=aquinopredio
STORAGE_SECRET_ACCESS_KEY=aquinopredio-dev
STORAGE_PUBLIC_URL=http://localhost:8333/aquinopredio
STORAGE_FORCE_PATH_STYLE=true

# Geolocalização (OpenStreetMap — respeite a política de uso: 1 req/s e User-Agent com contato).
# Os servidores públicos do Overpass às vezes ficam sobrecarregados (504); a validação tenta de novo
# com espera. Em produção, considere uma instância própria ou um mirror em OVERPASS_URL.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
GEO_USER_AGENT=AquiNoPredio/0.1 (dev; contato@aquinopredio.local)

# IA — OpenRouter. Sem chave, o app segue a RN-113 (prédios e anúncios vão para revisão manual)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Aqui no Predio
OPENROUTER_MODEL_AD_GENERATION=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_BUILDING_VALIDATION=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_MODERATION=anthropic/claude-haiku-5.5
# Sem IA de moderação: review (fila manual, padrão) ou approve (só dev, após filtro local)
MODERATION_WITHOUT_AI=review

# Web Push — gerar com: pnpm --filter api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@aquinopredio.local

# Filas e jobs agendados neste processo
WORKERS_ENABLED=true
