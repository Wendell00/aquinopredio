# App
NODE_ENV=development
PORT=3001
# Origens permitidas no CORS (separadas por vírgula)
WEB_ORIGIN=http://localhost:3000
# Rate limit global (requisições por janela)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Banco (PostgreSQL + PostGIS) — docker compose up -d (raiz do repo). Mesma conexão usada no Beekeeper Studio
DATABASE_URL=postgresql://aquinopredio:aquinopredio@localhost:5433/aquinopredio

# IA — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Aqui no Predio
OPENROUTER_MODEL_AD_GENERATION=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_BUILDING_VALIDATION=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_MODERATION=anthropic/claude-haiku-5.5

# Filas
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Storage de imagens (S3 / R2 / Supabase)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Geolocalização (opcional se usar Nominatim/OSM)
GOOGLE_MAPS_API_KEY=

# Web Push — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# Confirmação de telefone (opcional no início)
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
